{
  "name": "preact-prop-helpers",
  "type": "module",
  "version": "0.0.1",
  "description": "A small set of hooks and other functions related to modifying Preact props.",
  "source": "src/index.tsx",
  "module": "/dist/preact/index.js",
  "types": "/dist/preact/index.d.ts",
  "typings": "./dist/preact/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.mts",
      "browser": "./dist/react/index.mjs",
      "import": "./dist/react/index.mjs"
    },
    "./preact": {
      "types": "./dist/preact/index.d.mts",
      "browser": "./dist/preact/index.mjs",
      "import": "./dist/preact/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "playwright test",
    "test-ui": "playwright test --ui",
    "lint": "npx eslint ./src",
    "clean": "tsc --build --clean",
    "rebuild": "rm \"./pnpm-lock.yaml\" && rm -R \"./node_modules\" && pnpm install && pnpm run build"
  },
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "preact": "^11.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "rolldown": "^1.2.15",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "async-to-sync": "github:mwszekely/async-to-sync",
    "blocking-elements": "^0.1.1",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "map-and-set-extensions": "github:mwszekely/map-and-set-extensions",
    "tabbable": "^6.5.0"
  },
  "directories": {
    "test": "tests"
  }
}
