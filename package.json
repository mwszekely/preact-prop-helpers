{
  "name": "preact-prop-helpers",
  "type": "module",
  "version": "0.0.1",
  "description": "A small set of hooks and other functions related to modifying Preact props.",
  "source": "src/index.tsx",
  "module": "/packages/lib/dist/preact/index.js",
  "types": "/packages/lib/dist/preact/index.d.ts",
  "typings": "./packages/lib/dist/preact/index.d.ts",
  "sideEffects": false,
  "workspaces": [
    "packages/lib",
    "packages/docs",
    "packages/tests"
  ],
  "exports": {
    "./react": {
      "types": "./packages/lib/dist/react/index.d.mts",
      "browser": "./packages/lib/dist/react/index.mjs",
      "import": "./packages/lib/dist/react/index.mjs"
    },
    "./preact": {
      "types": "./packages/lib/dist/preact/index.d.mts",
      "browser": "./packages/lib/dist/preact/index.mjs",
      "import": "./packages/lib/dist/preact/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:docs && npm run build:tests",
    "build:lib": "npm run build --workspace packages/lib",
    "build:docs": "npm run build --workspace packages/docs",
    "build:tests": "npm run build --workspace packages/tests",
    "typecheck": "tsc",
    "test": "playwright test",
    "test-ui": "playwright test --ui"
  },
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "preact": "^11.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {},
  "dependencies": {
    "async-to-sync": "github:mwszekely/async-to-sync",
    "blocking-elements": "^0.1.1",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "map-and-set-extensions": "github:mwszekely/map-and-set-extensions",
    "tabbable": "^6.5.0"
  }
}
