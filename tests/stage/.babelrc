{
    "comments": true,
    "sourceMaps": true,
    "presets": [
        [
            "@babel/preset-env",
            {
                "corejs": 3,
                "shippedProposals": true,
                "targets": {
                    "browsers": "iOS 13"
                }
            }
        ]
    ],
    "plugins": [["polyfill-corejs3", { "method": "entry-global", "version": "3.48" }]]
}